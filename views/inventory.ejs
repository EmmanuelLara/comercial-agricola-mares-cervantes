<%- include('partials/header') %>

<div class="inventory fade-in">
    <div class="header-actions">
        <h1>Inventario de Productos</h1>
        <button class="btn btn-primary" onclick="showModal()"><i class="fas fa-plus"></i> Nuevo Producto</button>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Stock</th>
                    <th>P. Compra</th>
                    <th>P. Venta</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if(productos && productos.length > 0) { %>
                    <% productos.forEach(producto => { %>
                        <tr>
                            <td><span class="badge secondary">#<%= producto.Numero %></span></td>
                            <td><strong><%= producto.Nombre %></strong></td>
                            <td><span class="text-muted"><%= producto.Descripcion || 'Sin descripción' %></span></td>
                            <td>
                                <span class="badge <%= producto.Stock <= 5 ? 'danger' : (producto.Stock <= 15 ? 'warning' : 'success') %>">
                                    <i class="fas fa-box"></i> <%= producto.Stock %>
                                </span>
                            </td>
                            <td>$<%= producto.Precio_Compra.toFixed(2) %></td>
                            <td><strong class="text-primary">$<%= producto.Precio_venta.toFixed(2) %></strong></td>
                            <td>
                                <span class="badge <%= producto.Estado === 'Activo' ? 'info' : 'secondary' %>">
                                    <%= producto.Estado %>
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; gap: 4px;">
                                    <button class="btn-icon" title="Editar"><i class="fas fa-edit"></i></button>
                                    <button class="btn-icon danger" title="Eliminar"><i class="fas fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 4rem;">
                            <div style="color: var(--text-muted);">
                                <i class="fas fa-box-open" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.3;"></i>
                                <p>No hay productos registrados en el inventario</p>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal para Nuevo Producto -->
<div id="productModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Añadir Nuevo Producto</h2>
            <button class="close-btn" onclick="hideModal()">&times;</button>
        </div>
        <form action="/inventory" method="POST">
            <div class="form-grid">
                <div class="form-group">
                    <label>Código (Número)</label>
                    <input type="text" name="Numero" required placeholder="Ex: PRD-001">
                </div>
                <div class="form-group">
                    <label>Código Origen (Opcional)</label>
                    <input type="text" name="Numero_Origen" placeholder="Ex: 123456">
                </div>
            </div>
            
            <div class="form-group">
                <label>Nombre del Producto</label>
                <input type="text" name="Nombre" required placeholder="Nombre descriptivo">
            </div>

            <div class="form-group">
                <label>Descripción</label>
                <textarea name="Descripcion" rows="3" placeholder="Detalles del producto..."></textarea>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Stock Inicial</label>
                    <input type="number" name="Stock" value="0">
                </div>
                <div class="form-group">
                    <label>Precio Compra</label>
                    <input type="number" step="0.01" name="Precio_Compra" required placeholder="0.00">
                </div>
                <div class="form-group">
                    <label>Precio Venta</label>
                    <input type="number" step="0.01" name="Precio_venta" required placeholder="0.00">
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn secondary" onclick="hideModal()">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Producto</button>
            </div>
        </form>
    </div>
</div>
<style>
    .inventory {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
</style>

<script>
    function showModal() {
        document.getElementById('productModal').style.display = 'flex';
    }
    function hideModal() {
        document.getElementById('productModal').style.display = 'none';
    }
    window.onclick = function(event) {
        if (event.target == document.getElementById('productModal')) hideModal();
    }
</script>

<%- include('partials/footer') %>
