<%- include('partials/header') %>

<div class="error-page fade-in" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 60vh; text-align: center; padding: 2rem;">
    <div style="font-size: 6rem; color: var(--danger); margin-bottom: 1.5rem; filter: drop-shadow(0 4px 12px rgba(239, 68, 68, 0.2));">
        <i class="fas fa-exclamation-triangle"></i>
    </div>
    
    <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--text-main); margin-bottom: 1rem; letter-spacing: -1px;">
        Vaya, algo salió mal
    </h1>
    
    <div style="background: white; padding: 2rem 3rem; border-radius: 20px; box-shadow: var(--shadow); border: 1px solid #fecaca; max-width: 500px; margin-bottom: 2.5rem;">
        <p style="font-size: 1.1rem; color: var(--text-muted); line-height: 1.6; font-weight: 500;">
            <%= typeof message !== 'undefined' ? message : (typeof error !== 'undefined' ? error : 'Ocurrió un error inesperado en el servidor.') %>
        </p>
    </div>
    
    <div style="display: flex; gap: 1rem;">
        <button onclick="history.back()" class="btn secondary">
            <i class="fas fa-arrow-left"></i> Volver atrás
        </button>
        <a href="/" class="btn btn-primary">
            <i class="fas fa-home"></i> Regresar al Inicio
        </a>
    </div>
    
    <div style="margin-top: 4rem; color: #cbd5e1; font-size: 0.85rem; font-weight: 600;">
        <i class="fas fa-code"></i> Error de Sistema - Comercial Agrícola Mares Cervantes
    </div>
</div>

<%- include('partials/footer') %>
